{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:free",
  "outputDirectory": "dist/client",
  "installCommand": "npm ci",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{data/atlas.sqlite,data/pay-model.json,data/model/**,node_modules/onnxruntime-node/bin/napi-v3/linux/x64/**}",
      "maxDuration": 30,
      "excludeFiles": "node_modules/onnxruntime-node/bin/napi-v3/{darwin,win32,linux/arm64}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__atlasRoute=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
