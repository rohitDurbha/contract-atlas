# Copy to .env for local runs. Every value is optional.

# LLM enrichment at collection time (roadmap item 6). Groq is used first and
# Gemini is the fallback. With neither key set, the refresh skips enrichment.
GROQ_API_KEY=
GEMINI_API_KEY=
# Override the default models when a provider retires one.
ENRICH_GROQ_MODEL=
ENRICH_GEMINI_MODEL=
# Roles enriched per refresh (default 40) and the wait between calls in
# milliseconds (default 4000), which keeps both free tiers under their limits.
# In GitHub Actions these four settings are optional repository variables.
ENRICH_MAX_PER_RUN=
ENRICH_DELAY_MS=

# Semantic search vectors (roadmap item 7). The refresh downloads
# bge-small-en-v1.5 through fastembed into this folder the first time
# (default .cache/fastembed, which the workflow caches) and embeds at most
# EMBED_MAX_PER_RUN new or edited roles a run (default 1500). No key is needed.
FASTEMBED_CACHE=
EMBED_MAX_PER_RUN=

# Only the refresh workflow needs this, to deploy to Vercel.
VERCEL_TOKEN=
